# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# PostgreSQL
PGHOST=localhost
PGPORT=5432
PGUSER=brickmaster_user
PGPASSWORD=change_this_password
PGDATABASE=brickmaster_erp
DATABASE_URL=postgresql://brickmaster_user:change_this_password@localhost:5432/brickmaster_erp

# JWT
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=replace_with_another_long_random_secret
JWT_REFRESH_EXPIRES_IN=30d

# File storage (local disk in dev; swap for S3/Cloud Storage in prod)
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=15

# Rate limiting
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX=300
